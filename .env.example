# Template. Salin jadi .env.local lalu isi nilainya di sana.
# JANGAN isi nilai asli di file ini — .env.example ikut ter-commit ke git,
# sementara .env.local diabaikan lewat pola .env*.local di .gitignore.

# Firebase — Project Settings > General > Your apps > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — Project Settings > Service Accounts > Generate new private key
# private_key disalin apa adanya dari file JSON: satu baris, \n dibiarkan literal,
# seluruh nilai dibungkus tanda kutip ganda
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary — Dashboard > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
